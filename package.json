{
	"name": "peerhub",
	"productName": "PeerHub",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "desktop/main.js",
	"description": "Peer-to-peer code hosting: repositories, history, branches and forks with no server",
	"author": "PeerHub contributors",
	"bin": {
		"peerhub": "cli/peerhub.mjs"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"desktop": "npm run build && electron .",
		"desktop:dev": "node scripts/dev-desktop.mjs",
		"desktop:smoke": "npm run build && electron . --smoke",
		"dist": "npm run build && electron-builder",
		"dist:dir": "npm run build && electron-builder --dir",
		"cli": "node cli/peerhub.mjs",
		"test": "node --import ./tests/register.mjs --test --test-reporter=tap \"tests/*.test.ts\"",
		"build:schema": "node scripts/build-schema.cjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"clean": "node scripts/clean.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.7.0",
		"electron": "^40.0.0",
		"electron-builder": "^26.0.0",
		"mermaid": "^12.2.0",
		"prettier": "^3.8.1",
		"prettier-config-holepunch": "^2.0.0",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"b4a": "^1.8.0",
		"compact-encoding": "^2.19.2",
		"corestore": "^7.9.2",
		"distributed-drive": "^1.0.1",
		"ghost-picker": "file:./packages/picker",
		"hyperbee2": "^1.0.0",
		"hyperdb": "^6.6.1",
		"hyperdrive": "^13.3.2",
		"hyperschema": "^1.20.1",
		"hyperswarm": "^4.17.0",
		"localdrive": "^2.2.1",
		"paparam": "^1.10.1",
		"protomux": "^3.10.3",
		"protomux-rpc": "^1.9.0",
		"rabin-native": "^2.0.0",
		"ready-resource": "^1.2.0",
		"record-cache": "^2.0.0",
		"safety-catch": "^1.0.3",
		"sodium-native": "^5.1.0",
		"streamx": "^2.25.0"
	}
}
